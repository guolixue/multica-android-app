# Mobile production env — points at the self-hosted dsh.shuzhipin.cn instance.
# Loaded by the `*:prod` scripts via dotenv-cli (see package.json).
#
# EXPO_PUBLIC_API_URL is an origin only: every request path already carries its
# own prefix (`/api/*`, `/auth/*`, `/ws`), so appending `/api` here would produce
# `/api/api/*` and 404. Verified against dsh.shuzhipin.cn — `/api/config` → 200,
# `/api/issues` → 401, and `/ws` reaches the backend's WS handler.
EXPO_PUBLIC_API_URL=https://dsh.shuzhipin.cn
EXPO_PUBLIC_WEB_URL=https://dsh.shuzhipin.cn
